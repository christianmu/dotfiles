# --- PATH helpers ------------------------------------------------------------

path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

path_append() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$PATH:$1" ;;
    esac
}

path_dedupe() {
    local IFS=':'
    local -a parts out
    local p

    read -ra parts <<< "$PATH"
    for p in "${parts[@]}"; do
        p="${p%/}"
        [ -n "$p" ] || continue
        case ":${out[*]}:" in
            *":$p:"*) ;;
            *) out+=("$p") ;;
        esac
    done

    PATH="$(IFS=':'; echo "${out[*]}")"
}

# Prefer user tools first
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

# Add ~/bin subfolders (e.g. ~/bin/backup, ~/bin/web, ...)
for dir in "$HOME/bin"/*; do
    [ -d "$dir" ] && path_append "$dir"
done

path_prepend "/usr/local/bin"
path_prepend "/usr/local/sbin"

# Optional tools (only if installed)
path_prepend "/usr/local/cuda/bin"
path_append "$HOME/Meine-Apps/PhpStorm-251.26927.60/bin"
path_prepend "$HOME/.config/composer/vendor/bin"

export PYENV_ROOT="$HOME/.pyenv"
path_prepend "$PYENV_ROOT/bin"

# Final cleanup
path_dedupe
export PATH

# --- pyenv -------------------------------------------------------------------

command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

